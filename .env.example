# NAUKRI_EMAILS is managed automatically — the app appends to it the first
# time you log in with a new email, so you don't need to set it by hand.
# (Multiple emails, comma-separated, if you use more than one account.)
NAUKRI_EMAILS=

# Your Naukri password is NEVER stored here or anywhere else — the app asks
# for it every run.

# Optional: default shown when it asks "Target jobs to apply" (still asks
# every run unless you pass --jobs on the command line).
JOBS=20
